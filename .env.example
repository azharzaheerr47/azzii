# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="MY_APP_URL"

# MongoDB Atlas connection string (optional in local preview; required for MongoDB Atlas persistence)
MONGODB_URI=

# Cloudinary credentials for image uploads (required in Vercel production for persistent theme & note images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or a single Cloudinary connection URI (cloudinary://api_key:api_secret@cloud_name):
CLOUDINARY_URL=

# Secret key for signing HTTP-only session tokens (set a 32+ char secret in Vercel to persist sessions across cold starts)
AUTH_SECRET=
