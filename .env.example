# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="MY_APP_URL"

# MongoDB Atlas connection string (optional in local preview; required for MongoDB Atlas persistence)
MONGODB_URI=

# Cloudinary credentials for image uploads (optional in local preview; required for Cloudinary storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret key for signing HTTP-only session tokens (auto-generates secure ephemeral fallback in dev if unset)
AUTH_SECRET=
