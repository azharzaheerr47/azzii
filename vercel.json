{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__vercel_path=:path*" },
    { "source": "/robots.txt", "destination": "/api?__vercel_path=robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api?__vercel_path=sitemap.xml" },
    { "source": "/((?!api(?:/|$)|assets/|favicon\\.svg|.*\\..*).*)", "destination": "/index.html" }
  ]
}
